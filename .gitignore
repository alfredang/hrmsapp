# Secrets — never commit
.env
*.p8

# XcodeGen output (regenerate with `xcodegen generate`)
*.xcodeproj

# Xcode / build
.DS_Store
DerivedData/
build/
/tmp/
*.xcarchive
*.ipa
*.dSYM.zip
xcuserdata/

# Screenshots: keep framed output, ignore raw simulator captures
screenshots/raw/

# iOS signing credentials imported with skills — never commit
.claude/skills/**/org-credentials.env
.claude/skills/**/*.env
.playwright-mcp/
__pycache__/
*.pyc

# Distribution archives (rebuildable — never pushed to GitHub)
*.zip

# Source material the project was derived from — not ours to republish.
**/reference/

# Signing assets — never committed
*.mobileprovision
*.pem
*.key
